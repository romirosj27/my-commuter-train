# --- Core ---
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://commute:commute@localhost:5432/commute
TEST_DATABASE_URL=postgres://commute:commute@localhost:5432/commute_test
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=8080
# Public URLs. In dev the web app proxies /api to the API, so both are the web origin.
API_PUBLIC_URL=http://localhost:5173
WEB_URL=http://localhost:5173
# Production only, when web and API are sibling subdomains (app.example.com / api.example.com)
COOKIE_DOMAIN=
# At least 32 random characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-0123456789
RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT_PER_MIN=30
# Comma-separated emails allowed to edit Delay Repay rules
ADMIN_EMAILS=

# --- Email: console (dev, prints to the API log) | resend ---
EMAIL_TRANSPORT=console
EMAIL_FROM=My Commuter Train <alerts@localhost>
RESEND_API_KEY=

# --- Worker ---
WORKER_HEALTH_PORT=8081
INCIDENTS_POLL_SEC=120
ALERT_SWEEP_SEC=300

# Prediction thresholds (JSON, any subset of packages/shared/src/prediction DEFAULT_PREDICTION_CONFIG)
PREDICTION_CONFIG=

# --- Web (build time; apps/web) ---
# Leave empty in dev (Vite proxies /api). In production: the API's public URL.
VITE_API_URL=
# 1 = self-contained demo build (mock data in the browser, no server)
VITE_DEMO=

# --- Feed modes: mock | live (each feed independently) ---
DARWIN_MODE=mock
NETWORK_RAIL_MODE=mock
HSP_MODE=mock
INCIDENTS_MODE=mock
REFERENCE_MODE=mock

# Mock replay: scenario clock. Leave MOCK_CLOCK_START empty to anchor to today.
MOCK_SCENARIO=all
MOCK_CLOCK_START=
MOCK_CLOCK_SPEED=1

# --- Live feed credentials (placeholders; names will change once official docs are supplied) ---
DARWIN_CREDENTIALS=
NETWORK_RAIL_CREDENTIALS=
HSP_CREDENTIALS=
INCIDENTS_CREDENTIALS=
