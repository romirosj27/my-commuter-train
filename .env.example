# --- Core ---
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://commute:commute@localhost:5432/commute
TEST_DATABASE_URL=postgres://commute:commute@localhost:5432/commute_test
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=8080
WEB_ORIGIN=http://localhost:5173
RATE_LIMIT_PER_MIN=300

# --- Worker ---
WORKER_HEALTH_PORT=8081
INCIDENTS_POLL_SEC=120

# --- Feed modes: mock | live (each feed independently) ---
DARWIN_MODE=mock
NETWORK_RAIL_MODE=mock
HSP_MODE=mock
INCIDENTS_MODE=mock
REFERENCE_MODE=mock

# Mock replay: scenario clock. Leave MOCK_CLOCK_START empty to anchor to today.
MOCK_SCENARIO=all
MOCK_CLOCK_START=
MOCK_CLOCK_SPEED=1

# --- Live feed credentials (placeholders; names will change once official docs are supplied) ---
DARWIN_CREDENTIALS=
NETWORK_RAIL_CREDENTIALS=
HSP_CREDENTIALS=
INCIDENTS_CREDENTIALS=
