{
  "name": "my-commuter-train",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:generate": "pnpm --filter @mct/db generate",
    "db:migrate": "pnpm --filter @mct/db migrate",
    "db:seed": "pnpm --filter @mct/db seed",
    "dev:api": "pnpm --filter @mct/api dev",
    "dev:worker": "pnpm --filter @mct/worker dev",
    "dev:web": "pnpm --filter @mct/web dev"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
